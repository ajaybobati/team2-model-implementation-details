{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QualityCheckResponse",
  "type": "object",
  "properties": {
    "dataset_name": {
      "type": "string"
    },
    "execution_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "total_rows_scanned": {
      "type": "integer"
    },
    "status": {
      "type": "string",
      "enum": [
        "PASSED",
        "FAILED_VALIDATION"
      ]
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rule_id": {
            "type": "string"
          },
          "column": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "CRITICAL",
              "HIGH",
              "MEDIUM",
              "LOW"
            ]
          },
          "failed_count": {
            "type": "integer"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "rule_id",
          "column",
          "severity",
          "failed_count",
          "description"
        ]
      }
    }
  },
  "required": [
    "dataset_name",
    "execution_timestamp",
    "total_rows_scanned",
    "status",
    "violations"
  ]
}