{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DataQualityValidationResponse",
  "type": "object",
  "properties": {
    "dataset_name": {
      "type": "string"
    },
    "compliance_status": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "WARNING"
      ]
    },
    "validation_results": {
      "type": "array"
    }
  },
  "required": [
    "dataset_name",
    "compliance_status",
    "validation_results"
  ]
}