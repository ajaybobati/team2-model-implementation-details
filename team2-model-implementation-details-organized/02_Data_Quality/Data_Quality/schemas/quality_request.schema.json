
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QualityCheckRequest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "dataset_name": {
      "type": "string",
      "minLength": 1
    },
    "file_path": {
      "type": "string",
      "minLength": 1
    },
    "rules_to_apply": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "NULL_CHECK",
          "DUP_ROW",
          "INVALID_RANGE",
          "OUTLIER_IQR"
        ]
      },
      "uniqueItems": true,
      "default": [
        "NULL_CHECK",
        "DUP_ROW",
        "INVALID_RANGE",
        "OUTLIER_IQR"
      ]
    },
    "target_col": {
      "type": [
        "string",
        "null"
      ]
    },
    "id_cols": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "numeric_columns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "required": [
    "dataset_name",
    "file_path"
  ]
}
