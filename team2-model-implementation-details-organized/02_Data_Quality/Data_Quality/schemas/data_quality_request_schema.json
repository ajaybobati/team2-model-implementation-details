{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DataQualityValidationRequest",
  "type": "object",
  "properties": {
    "dataset_name": {
      "type": "string"
    },
    "rules_to_apply": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "NULL_CHECK",
          "DUP_ROW",
          "INVALID_RANGE",
          "OUTLIER_IQR"
        ]
      }
    }
  },
  "required": [
    "dataset_name",
    "rules_to_apply"
  ]
}