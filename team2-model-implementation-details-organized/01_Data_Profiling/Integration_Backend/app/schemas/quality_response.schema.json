
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Team2DataQualityValidationResponse",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "dataset_name": {
      "type": "string"
    },
    "execution_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "total_rows_scanned": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "type": "string",
      "enum": ["PASSED", "FAILED_VALIDATION"]
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "rule_id": {
            "type": "string",
            "enum": ["NULL_CHECK", "DUP_ROW", "INVALID_RANGE", "OUTLIER_IQR"]
          },
          "column": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]
          },
          "failed_count": {
            "type": "integer",
            "minimum": 0
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "rule_id",
          "column",
          "severity",
          "failed_count",
          "description"
        ]
      }
    }
  },
  "required": [
    "dataset_name",
    "execution_timestamp",
    "total_rows_scanned",
    "status",
    "violations"
  ]
}
